# Copy to .env.local for development, or set these as environment variables in production.

# Session signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the app auto-generates and persists one in data/secret.key.
SESSION_SECRET=

# Optional: point the app at an alternate SQLite database path (default: data/db.sqlite).
# DATABASE_PATH=

# Base URL used for absolute links (QR values, invoice emails, canonical URLs).
# Example: https://nextgen.example.com
NEXT_PUBLIC_SITE_URL=

# Razorpay credentials. If unset, the app runs in sandbox/demo mode
# (fake orders + instant verification) so you can test the checkout without a merchant account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional outbound automation (fire-and-forget webhooks). Leave unset to stay simulated.
# Contract: POST JSON with { to, title, body, type, meta } — see README.md.
#   WHATSAPP_WEBHOOK_URL  -> receives the JSON with `to` = phone (+91...)
#   EMAIL_WEBHOOK_URL     -> same shape, `title` is the subject, `to` is the email
WHATSAPP_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=

# Direct provider adapters (alternative to the webhooks above).
#   RESEND_API_KEY / RESEND_FROM  -> email channel via Resend
RESEND_API_KEY=
RESEND_FROM="NEXTGEN FITNESS <onboarding@resend.dev>"

# Optional web analytics.
NEXT_PUBLIC_GA_ID=
